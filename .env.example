# Copy to .env. Replace the database URL placeholders.

# Supabase transaction pooler (port 6543), including for Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL=require
# Optional CA bundle path.
DATABASE_CA_CERT=certs/supabase-ca.crt

# API
NODE_ENV=development
PORT=4000
# Optional: debug, info, warn, or error. Defaults to info.
# LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
TRUST_PROXY=false

# Auth and webhooks. Generate secrets with: openssl rand -hex 32
SESSION_SECRET=
WEBHOOK_SECRET=
# Optional destination for npm run send-event.
# WEBHOOK_URL=https://api.example.com/webhooks/app

# Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Frontend
VITE_API_BASE_URL=
# Optional Vite dev-server proxy target.
# VITE_DEV_API_ORIGIN=http://localhost:4000
