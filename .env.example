# Copy to .env. This file is tracked; .env is not.
# Generate secrets with: openssl rand -hex 32

# Supabase > Connect > Session pooler, port 5432 (IPv4; 6543 is transaction mode).
# Use the database password, not the publishable key. Percent-encode @ as %40.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=require
DATABASE_CA_CERT=certs/supabase-ca.crt

NODE_ENV=development
PORT=4000
# Local: http://localhost:5173  Production: your Vercel URL, comma-separated if several
CORS_ORIGINS=http://localhost:5173

# Local: lax / false. Behind HTTPS on a different origin: none / true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Local: false. Behind nginx: true.
TRUST_PROXY=false

SESSION_SECRET=
# Generate with: npm run hash-password
APP_PASSWORD_HASH=
WEBHOOK_SECRET=
# Optional. npm run send-event posts here. Defaults to http://127.0.0.1:$PORT/webhooks/app
# WEBHOOK_URL=https://api.example.com/webhooks/app

# Without a key the assistant reports itself unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Leave blank locally. Never put a secret in a VITE_ variable.
VITE_API_BASE_URL=

# Vite only. Used by npm run dev:web when the API is not on port 4000.
# VITE_DEV_API_ORIGIN=http://localhost:4000
