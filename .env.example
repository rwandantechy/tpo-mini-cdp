# Copy to .env. This file is tracked; .env is not.
# Generate secrets with: openssl rand -hex 32

# Supabase > Connect > Session pooler, port 5432 (IPv4; 6543 is transaction mode).
# Use the database password, not the publishable key. Percent-encode @ as %40.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=require
# Optional CA bundle path. If blank, Node verifies the certificate using its trusted roots.
DATABASE_CA_CERT=certs/supabase-ca.crt

NODE_ENV=development
PORT=4000
# Optional: error, warn, info, or debug. Defaults to info outside tests.
# LOG_LEVEL=info
# Local: http://localhost:5173. On Vercel the deployment host is also allowed via VERCEL_URL.
CORS_ORIGINS=http://localhost:5173

# Shared Vercel domain: lax / true. A separate API host would need none / true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Local: false. Vercel and nginx: true. Vercel also turns this on when VERCEL=1.
TRUST_PROXY=false

SESSION_SECRET=
# Generate with: npm run hash-password
APP_PASSWORD_HASH=
WEBHOOK_SECRET=
# Optional webhook destination for npm run send-event. Defaults to http://127.0.0.1:$PORT/webhooks/app.
# WEBHOOK_URL=https://api.example.com/webhooks/app

# Without a key the assistant reports itself unavailable.
GEMINI_API_KEY=
# 3.8 Flash is free but often busy. Lite stays on the free tier and is usually available.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Leave blank locally and on the shared Vercel domain. Never put a secret in a VITE_ variable.
VITE_API_BASE_URL=

# Vite only. Used by npm run dev:web when the API is not on port 4000.
# VITE_DEV_API_ORIGIN=http://localhost:4000
