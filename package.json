{
  "name": "tpo-mini-cdp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A mini CDP that unifies newsletter, website and app activity for The Pour Over's Growth team.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "import": "tsx scripts/import-csv.ts",
    "send-event": "tsx scripts/send-event.ts",
    "create-user": "tsx scripts/create-user.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
